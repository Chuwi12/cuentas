# Copia a .env y ajusta. .env está en .gitignore.
DATABASE_URL=postgres://finanzas:finanzas_dev@127.0.0.1:5433/finanzas
BIND_ADDR=127.0.0.1:8080
# Genera uno propio: openssl rand -base64 48
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-de-verdad
# Duración de la sesión en horas
SESSION_HOURS=720
# true en producción tras HTTPS: marca la cookie como Secure
COOKIE_SECURE=false
RUST_LOG=info,finanzas_backend=debug,tower_http=debug

# --- Asesor con LLM local (opcional: sin ASESOR_TOKEN la app funciona igual, sin asesor) ---
# Secreto compartido entre el backend y el asesor: openssl rand -base64 48
ASESOR_TOKEN=
ASESOR_URL=http://127.0.0.1:8090
ASESOR_PORT=8090
# BD propia del asesor (./scripts/db.sh asesor install), separada de la de finanzas
ASESOR_DATABASE_URL=postgres://asesor:asesor_dev@127.0.0.1:5435/asesor
OLLAMA_URL=http://127.0.0.1:11434
ASESOR_MODEL=qwen3.5:4b
ASESOR_EMBED_MODEL=embeddinggemma:300m-qat-q8_0
ASESOR_NUM_CTX=4096
ASESOR_KEEP_ALIVE=5m
