# Copia a .env y ajusta. .env está en .gitignore.
DATABASE_URL=postgres://finanzas:finanzas_dev@127.0.0.1:5433/finanzas
BIND_ADDR=127.0.0.1:8080
# Genera uno propio: openssl rand -base64 48
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-de-verdad
# Duración de la sesión en horas
SESSION_HOURS=720
# true en producción tras HTTPS: marca la cookie como Secure
COOKIE_SECURE=false
RUST_LOG=info,finanzas_backend=debug,tower_http=debug
